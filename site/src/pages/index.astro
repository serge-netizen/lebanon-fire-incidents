---
// Root: send visitors to the default language. A static site cannot read the
// Accept-Language header, so this is a plain redirect; the language switch is on every page.
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/ar/" />
    <link rel="canonical" href="/ar/" />
    <title>حرائق لبنان</title>
  </head>
  <body><a href="/ar/">العربية</a> · <a href="/en/">English</a> · <a href="/fr/">Français</a></body>
</html>
